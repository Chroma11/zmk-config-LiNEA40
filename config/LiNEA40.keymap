#define ZMK_POINTING_DEFAULT_SCRL_VAL 150

#include <dt-bindings/zmk/input_transform.h>
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <input/processors/runtime-input-processor.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define MOUSE 1
#define FUNCNUM 2
#define SYMBOLS 3
#define MEDIANAVI 4

// #define MARK 2
// #define CURSOR 3
// #define FUNCTION 4

#define SCROLL 5
#define WIRELESS 6

//mouse cursol

&mmv {
    delay-ms = <20>;
    trigger-period-ms = <5>;
    time-to-max-speed-ms = <100>;
    acceleration-exponent = <2>;
};

//mouse scroll

&msc {
    delay-ms = <3>;
    trigger-period-ms = <3>;
    time-to-max-speed-ms = <100>;
    acceleration-exponent = <0>;
};

/ {
    input_processors {
        zip_wheel_scaler: zip_wheel_scaler {
            compatible = "zmk,input-processor-scaler";
            #input-processor-cells = <2>;
            type = <INPUT_EV_REL>;
            codes = <INPUT_REL_WHEEL>;
            track-remainders;
        };
    };
};

&msc_input_listener {
    speed_up {
        layers = <2>;
        input-processors = <&zip_wheel_scaler 3 1>; //スクロールを3倍速にする
    };
};

&trackball_listener {
    /* mouse_runtime_input_processor の処理（減速など）を通した「後」に、
       オートマウスのレイヤー遷移（&zip_temp_layer）を配置することで、
       ホールド状態のレイヤー判定が破壊されて信号がドロップするのを防ぎます。
    */

    input-processors =
        <&mouse_runtime_input_processor>,
        <&zip_temp_layer 1 500>;

    scroller {
        layers = <5>;
        input-processors =
            <&zip_xy_transform INPUT_TRANSFORM_Y_INVERT>,
            <&zip_xy_to_scroll_mapper>,
            <&scroll_runtime_input_processor>;
    };
};

/ {
    combos {
        compatible = "zmk,combos";

        test {
            bindings = <&none>;
            key-positions = <0 4 5 9 10 14 15 19 20 24 25 29 30 35 36 40>;
        };

        ArrowUp {
            bindings = <&kp UP_ARROW>;
            key-positions = <6 7>;
        };

        ArrowDown {
            bindings = <&kp DOWN_ARROW>;
            key-positions = <16 17>;
        };

        EscCombo {
            bindings = <&kp ESC>;
            key-positions = <1 2>;
        };

        TabCombo {
            bindings = <&kp TAB>;
            key-positions = <11 12>;
        };
    };

    behaviors {
        re_kp: sensor_rotate_kp {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&kp>, <&kp>;
        };

        mouse_scrl: mouse_wheel_scrl {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <20>;
        };
    };

    macros {
        MP1: new_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp H &kp O &kp S &kp H &kp I &kp N2 &kp N5>;
            label = "NEW_MACRO";
        };

        MP2: PM2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp M &kp B &kp A>;
            label = "PM2";
        };

        MP3: PM3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(M) &kp N3>;
            label = "PM3";
        };

        WP1: PW1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(T) &kp N &kp LS(A) &kp F>;
            label = "PW1";
        };

        WP2: PW2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(V) &kp R>;
            label = "PW2";
        };

        WP3: PW3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N0 &kp N3 &kp EXCL>;
            label = "PW3";
        };

        ToMac: ToMac {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 0 &to 0>;
            label = "TOMAC";
        };

        ToWin: ToWin {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 1 &to 7>;
            label = "TOWIN";
        };

        ToTablet: ToTablet {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 2 &to 9>;
            label = "TOTABLET";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        //0

        default_layer {
            bindings = <
&lt 4 Q       &kp W        &kp E        &kp R       &kp T                                      &kp Y      &kp U       &kp I            &kp O         &lt 6 P
&lt 3 A       &kp S        &kp D        &lt 1 F     &kp G                                      &kp H      &kp J       &kp K            &kp L         &lt 2 MINUS
&mt LSHFT Z   &mt LCTRL X  &mt LALT C   &mt LGUI V  &kp B                                      &kp N      &mt RALT M  &mt RCTRL COMMA  &mt RGUI DOT  &mt RSHFT SLASH
&kp LEFT_WIN  &kp TAB      &lt 2 LANG2  &trans      &lt 5 DEL  &lt 2 BACKSPACE    &lt 2 ENTER  &kp ENTER              &lt 3 LANG1      &kp LEFT      &kp RIGHT
            >;

            sensor-bindings = <&mouse_scrl SCRL_UP SCRL_DOWN>;
        };

        //1

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                   &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans                   &trans  &mkp MB1  &mkp MB3  &mkp MB2  &trans
&trans  &trans  &trans  &trans  &trans                   &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &mo 5    &trans  &trans            &trans    &trans    &trans
            >;
        };

        //2

        FUNCNUM {
            bindings = <
&kp LS(ESC)   &kp LC(LS(NUMBER_1))  &kp LS(LG(NUMBER_2))  &kp LS(F4)  &kp LS(F5)                    &kp LS(SEMI)   &kp KP_N7  &kp KP_N8  &kp KP_N9   &kp KP_PLUS
&kp TAB       &kp F6                &kp F7                &kp F8      &kp F9                        &kp LS(N9)     &kp KP_N4  &kp KP_N5  &kp KP_N6   &kp KP_MINUS
&kp LEFT_WIN  &kp TAB               &kp EQUAL             &kp EQUAL   &kp LG(Q)                     &kp LS(N0)     &kp KP_N1  &kp KP_N2  &kp KP_N3   &kp KP_ASTERISK
&trans        &trans                &trans                &trans      &trans      &trans    &trans  &kp LS(ENTER)             &kp KP_N0  &kp KP_DOT  &kp KP_SLASH
            >;

            sensor-bindings = <&re_kp C_VOLUME_DOWN C_VOLUME_UP>;
        };

        //3

        SYMBOLS {
            bindings = <
&kp LS(NUMBER_1)  &kp LS(NUMBER_2)  &kp LS(NUMBER_3)  &kp LS(NUMBER_4)  &kp LS(NUMBER_5)                    &kp LS(NUMBER_6)   &kp LS(NUMBER_7)   &kp LS(NUMBER_8)  &kp LS(NUMBER_9)  &kp LS(NUMBER_0)
&kp TAB           &kp LS(EQUAL)     &kp EQUAL         &kp EQUAL         &kp LS(SQT)                         &kp EQUAL          &kp LS(SEMI)       &kp SEMI          &kp LBKT          &kp RBKT
&kp LEFT_WIN      &kp TAB           &kp LS(MINUS)     &kp LS(MINUS)     &kp SQT                             &kp LS(BACKSLASH)  &kp LS(BACKSLASH)  &kp SLASH         &kp COMMA         &kp DOT
&trans            &trans            &trans            &trans            &trans            &trans    &trans  &trans                                &trans            &kp DOWN          &kp LS(UP_ARROW)
            >;
        };

        //4

        MEDIANAVI {
            bindings = <
&trans  &kp LS(LG(NUMBER_3))  &kp LS(LG(NUMBER_4))  &kp F20  &kp C_VOLUME_UP                      &kp LC(LG(Q))  &trans    &MP1           &MP2         &MP3
&trans  &trans                &trans                &kp F21  &kp C_VOLUME_DOWN                    &trans         &kp LEFT  &kp DOWN       &kp UP       &kp RIGHT
&trans  &trans                &trans                &trans   &trans                               &trans         &kp HOME  &kp PAGE_DOWN  &kp PAGE_UP  &kp LC(LA(END))
&trans  &trans                &trans                &trans   &trans             &trans    &trans  &trans                   &trans         &trans       &trans
            >;

            sensor-bindings = <&mouse_scrl SCRL_UP SCRL_DOWN>;
        };

        //5

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans          &trans  &trans  &trans
            >;
        };

        //6

        WIRELESS {
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                         &bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&ToMac        &ToWin        &ToTablet     &trans        &trans                               &ToMac          &ToWin        &ToTablet     &trans        &trans
&trans        &trans        &trans        &trans        &trans                               &trans          &trans        &trans        &trans        &bt BT_CLR
&trans        &trans        &trans        &trans        &trans        &trans    &bootloader  &studio_unlock                &trans        &trans        &bt BT_CLR_ALL
            >;

            sensor-bindings = <&inc_dec_kp RIGHT_ARROW LEFT_ARROW>;
        };

        DEFAULT_WIN {
            bindings = <
&lt 8 Q       &kp W        &kp E        &kp R        &kp T                                      &kp Y      &kp U        &kp I           &kp O          &lt 6 P
&lt 3 A       &kp S        &kp D        &kp F        &kp G                                      &kp H      &kp J        &kp K           &kp L          &lt 2 MINUS
&mt LSHFT Z   &mt LCTRL X  &mt LALT C   &mt LCTRL V  &kp B                                      &kp N      &mt LCTRL M  &mt LALT COMMA  &mt LCTRL DOT  &mt RSHFT SLASH
&kp LEFT_WIN  &kp K_MENU   &lt 2 LANG2  &trans       &lt 5 DEL  &lt 2 BACKSPACE    &lt 2 ENTER  &kp ENTER               &lt 3 LANG1     &kp LEFT       &kp RIGHT
            >;

            sensor-bindings = <&mouse_scrl SCRL_UP SCRL_DOWN>;
        };

        MEDIANAVI_WIN {
            bindings = <
&trans  &kp LS(LG(NUMBER_3))  &kp LS(LG(NUMBER_4))  &kp F20  &kp C_VOLUME_UP                      &kp LG(L)  &kp LC(LA(DEL))  &WP1           &WP2         &WP3
&trans  &trans                &trans                &kp F21  &kp C_VOLUME_DOWN                    &trans     &kp LEFT         &kp DOWN       &kp UP       &kp RIGHT
&trans  &trans                &trans                &trans   &trans                               &trans     &kp HOME         &kp PAGE_DOWN  &kp PAGE_UP  &kp LC(LA(END))
&trans  &trans                &trans                &trans   &trans             &trans    &trans  &trans                      &trans         &trans       &trans
            >;

            sensor-bindings = <&mouse_scrl SCRL_UP SCRL_DOWN>;
        };

        DEFAULT_TABLET {
            bindings = <
&lt 4 Q       &kp W        &kp E        &kp R       &kp T                                      &kp Y      &kp U       &kp I            &kp O         &lt 6 P
&lt 3 A       &kp S        &kp D        &kp F       &kp G                                      &kp H      &kp J       &kp K            &kp L         &lt 2 MINUS
&mt LSHFT Z   &mt LCTRL X  &mt LALT C   &mt LGUI V  &kp B                                      &kp N      &mt RALT M  &mt RCTRL COMMA  &mt RGUI DOT  &mt RSHFT SLASH
&kp LEFT_WIN  &kp TAB      &lt 2 LANG2  &trans      &lt 5 DEL  &lt 2 BACKSPACE    &lt 2 ENTER  &kp ENTER              &lt 3 LANG1      &kp LEFT      &kp RIGHT
            >;

            sensor-bindings = <&mouse_scrl SCRL_UP SCRL_DOWN>;
        };
    };
};
