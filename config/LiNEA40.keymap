#define ZMK_POINTING_DEFAULT_SCRL_VAL 150

#include <dt-bindings/zmk/input_transform.h>
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <input/processors/runtime-input-processor.dtsi>

#define MOUSE 1
#define MARK 2
#define CURSOR 3
#define FUNCTION 4
#define SCROLL 5
#define WIRELESS 6

//mouse cursol

&mmv {
    delay-ms = <20>;
    trigger-period-ms = <5>;
    time-to-max-speed-ms = <100>;
    acceleration-exponent = <2>;
};

//mouse scroll

&msc {
    delay-ms = <3>;
    trigger-period-ms = <3>;
    time-to-max-speed-ms = <100>;
    acceleration-exponent = <0>;
};

/ {
    input_processors {
        zip_wheel_scaler: zip_wheel_scaler {
            compatible = "zmk,input-processor-scaler";
            #input-processor-cells = <2>;
            type = <INPUT_EV_REL>;
            codes = <INPUT_REL_WHEEL>;
            track-remainders;
        };
    };
};

&msc_input_listener {
    speed_up {
        layers = <FUNCTION>;
        input-processors = <&zip_wheel_scaler 3 1>; //スクロールを3倍速にする
    };
};

&trackball_listener {
    // 1. トラックボールのリスナー直下にマウス用のプロセッサを追加
    input-processors = <&mouse_runtime_input_processor>;

    scroller {
        layers = <5>;
        input-processors =
            <&zip_xy_transform INPUT_TRANSFORM_Y_INVERT>,
            //スクロール方向を逆転
            <&zip_xy_to_scroll_mapper>,
            // 2. スクローラーの設定の末尾にカンマで繋げて追加
            <&scroll_runtime_input_processor>;
    };
};

/ {
    combos {
        compatible = "zmk,combos";

        ZenkakuHankaku {
            bindings = <&kp GRAVE>;
            key-positions = <11 12>;
        };

        DeleteKey {
            bindings = <&kp DEL>;
            key-positions = <7 8>;
        };

        InsertKey {
            bindings = <&kp INS>;
            key-positions = <6 7>;
        };

        CenterClick {
            bindings = <&mkp MB3>;
            key-positions = <17 16>;
        };

        RightClick {
            bindings = <&mkp MB2>;
            key-positions = <18 17>;
        };

        PrevClick {
            bindings = <&mkp MB4>;
            key-positions = <27 28>;
        };

        ClickNext {
            bindings = <&mkp MB5>;
            key-positions = <26 27>;
        };
    };

    behaviors {
        re_kp: sensor_rotate_kp {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&kp>, <&kp>;
        };

        mouse_scrl: mouse_wheel_scrl {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        //0
        default_layer {
            bindings = <
&lt 4 Q         &kp W         &kp E               &kp R        &kp T                                            &kp Y        &kp U         &kp I                &kp O              &lt 6 P
&lt 3 A         &kp S         &kp D               &kp F        &kp G                                            &kp H        &kp J         &kp K                &kp L              &lt 2 MINUS
&mt LSHFT Z    &mt LCTRL X   &mt LALT C          &mt LGUI V   &kp B                                            &kp N        &mt RALT M    &mt RCTRL COMMA      &mt RGUI DOT       &mt RSHFT SLASH
&kp LEFT_WIN   &kp TAB       &lt 2 LANG2          &trans       &lt 5 DEL    &lt 2 BACKSPACE    &lt 2 ENTER      &kp ENTER    &lt 3 LANG1    &kp LEFT             &kp RIGHT
            >;
            sensor-bindings = <&mouse_scrl SCRL_DOWN SCRL_UP>;
        };

        //1
        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &mkp MB1  &mkp MB3  &mkp MB2  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans            &trans    &trans    &trans
            >;
        };

        //2
        MARK {
            bindings = <
&kp LS(ESC)   &kp LC(LS(NUMBER_1))  &kp LS(LG(NUMBER_2))  &kp LS(F4)   &kp LS(F5)                                     &kp LS(SEMI)  &kp KP_N7  &kp KP_N8  &kp KP_N9  &kp KP_PLUS
&kp TAB       &kp F6                &kp F7                &kp F8       &kp F9                                         &kp LS(N9)    &kp KP_N4  &kp KP_N5  &kp KP_N6  &kp KP_MINUS
&kp LEFT_WIN  &kp TAB               &kp EQUAL             &kp EQUAL    &kp LG(Q)                                      &kp LS(N0)    &kp KP_N1  &kp KP_N2  &kp KP_N3  &kp KP_ASTERISK
&trans        &trans                &trans                &trans       &trans     &trans    &trans  &kp LS(ENTER)               &kp KP_N0  &kp KP_DOT &kp KP_SLASH
            >;
            sensor-bindings = <&re_kp C_VOLUME_DOWN C_VOLUME_UP>;
        };

        //3
        CURSOR {
            bindings = <
&kp LS(NUMBER_1)  &kp LS(NUMBER_2)  &kp LS(NUMBER_3)  &kp LS(NUMBER_4)  &kp LS(NUMBER_5)                                &kp LS(NUMBER_6)  &kp LS(NUMBER_7)  &kp LS(NUMBER_8)  &kp LS(NUMBER_9)  &kp LS(NUMBER_0)
&kp TAB           &kp LS(EQUAL)     &kp EQUAL         &kp EQUAL         &kp LS(SQT)                                     &kp EQUAL         &kp LS(SEMI)      &kp SEMI          &kp LBKT          &kp RBKT
&kp LEFT_WIN      &kp TAB           &kp LS(MINUS)     &kp LS(MINUS)     &kp SQT                                         &kp LS(BACKSLASH) &kp LS(BACKSLASH) &kp SLASH         &kp COMMA         &kp DOT
&trans            &trans            &trans            &trans            &trans            &trans    &trans  &trans                        &trans            &kp DOWN          &kp LS(UP_ARROW)
            >;
        };

        //4
        FUNCTION {
            bindings = <
&trans  &kp LS(LG(NUMBER_3))  &kp LS(LG(NUMBER_4))  &kp F20  &kp C_VOLUME_UP                  &kp LC(LG(Q))  &trans    &trans         &trans       &trans
&trans  &trans                &trans                &kp F21  &kp C_VOLUME_DOWN                &trans         &kp LEFT  &kp DOWN       &kp UP       &kp RIGHT
&trans  &trans                &trans                &trans   &trans                           &trans         &kp HOME  &kp PAGE_DOWN  &kp PAGE_UP  &kp LC(LA(END))
&trans  &trans                &trans                &trans   &trans           &trans  &trans  &trans                   &trans         &trans       &trans
            >;
            sensor-bindings = <&mouse_scrl SCRL_DOWN SCRL_UP>;
        };

        //5
        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans          &trans  &trans  &trans
            >;
        };

        //6
        SETTINGS {
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                                  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans        &trans        &trans        &trans        &trans                                        &trans        &trans        &trans        &trans        &trans
&trans        &trans        &trans        &trans        &trans                                        &trans        &trans        &trans        &trans        &bt BT_CLR
&trans        &trans        &trans        &trans        &trans        &trans    &bootloader  &studio_unlock         &trans        &trans        &bt BT_CLR_ALL
            >;

            sensor-bindings = <&inc_dec_kp RIGHT_ARROW LEFT_ARROW>;
        };

    };
};
